-- plugins/which-key.lua
return {
  'folke/which-key.nvim',
  event = 'VeryLazy',
  config = function()
    local wk = require('which-key')

    -- Carga opcional de librerías
    local icons, util, prompts
    pcall(function() icons = require('lib.icons') end)
    pcall(function() util = require('lib.util') end)
    pcall(function() prompts = require('lib.prompts') end)

    wk.setup({
      plugins = {
        marks = true,
        registers = true,
        spelling = { enabled = true, suggestions = 20 },
        presets = {
          operators = true,
          motions = true,
          text_objects = true,
          windows = true,
          nav = true,
          z = true,
          g = true,
        },
      },
      icons = {
        breadcrumb = icons and icons.ui.ArrowOpen or ">",
        separator = icons and icons.ui.Arrow or "→",
        group = "",
      },
      window = {
        border = "rounded",
        position = "bottom",
        margin = {1,1,1,1},
        winblend = 10,
      },
      layout = { align = "center", spacing = 4 },
      show_help = false,
      triggers = {"<leader>"},
    })

    -- === Normal Mode Mappings ===
    local normal_mappings = {
      mode = 'n',

      -- Dashboard / General
      ["<leader>o"] = { ":Dashboard<cr>", "Dashboard" },
      ["<leader>e"] = { ":lua Snacks.explorer()<cr>", "File Explorer" },

      -- Telescope
      ["<leader>tf"] = { "<cmd>Telescope find_files<cr>", "Find Files" },
      ["<leader>tg"] = { "<cmd>Telescope live_grep<cr>", "Live Grep" },
      ["<leader>tb"] = { "<cmd>Telescope buffers<cr>", "Buffers" },
      ["<leader>th"] = { "<cmd>Telescope help_tags<cr>", "Help Tags" },

      -- Seeker
      ["<leader>fs"] = { ":SeekerFiles<cr>", "Seeker Files" },
      ["<leader>fg"] = { ":SeekerGrep<cr>", "Seeker Grep" },
      ["<leader>fb"] = { ":SeekerBuffers<cr>", "Seeker Buffers" },
      ["<leader>fh"] = { ":SeekerHelp<cr>", "Seeker Help" },

      -- AI
      ["<leader>a"] = { name = "AI" },
      ["<leader>apd"] = { prompts and prompts.add_prompt('docs') or ":echo 'Docs'<cr>", "Docs" },
      ["<leader>ape"] = { prompts and prompts.add_prompt('explain') or ":echo 'Explain'<cr>", "Explain" },

      -- LSP
      ["<leader>l"] = { name = "LSP" },
      ["<leader>la"] = { ":Lspsaga code_action<cr>", "Code Action" },
      ["<leader>ld"] = { ":Lspsaga goto_definition<cr>", "Goto Definition" },

      -- Git
      ["<leader>g"] = { name = "Git" },
      ["<leader>gs"] = { ":Gitsigns stage_hunk<cr>", "Stage Hunk" },
      ["<leader>gp"] = { ":Git push<cr>", "Git Push" },

      -- Terminal
      ["<leader>t"] = { name = "Terminal" },
      ["<leader>tt"] = { ":Fterm<cr>", "Terminal" },
      ["<leader>tp"] = { ":Sterm bpython<cr>", "Python Terminal" },
    }

    -- === Visual Mode Mappings ===
    local visual_mappings = {
      mode = 'v',
      ["<leader>ce"] = { "<esc>:'<,'>SnipRun<cr>", "Execute Selection" },
    }

    -- === No-leader Mappings ===
    local no_leader = {
      mode = 'n',
      ["<C-h>"] = { ":NavigatorLeft<cr>", "Move Left" },
      ["<C-j>"] = { ":NavigatorDown<cr>", "Move Down" },
      ["<C-k>"] = { ":NavigatorUp<cr>", "Move Up" },
      ["<C-l>"] = { ":NavigatorRight<cr>", "Move Right" },
    }

    wk.register(normal_mappings)
    wk.register(visual_mappings)
    wk.register(no_leader)
  end
}

