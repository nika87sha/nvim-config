# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# Lua files
[*.lua]
indent_style = space
indent_size = 2
max_line_length = 120

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# YAML/YML files (Kubernetes, Ansible, Docker Compose)
[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 120

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Terraform files
[*.{tf,tfvars}]
indent_style = space
indent_size = 2
max_line_length = 120

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = 88

# Make
[Makefile]
indent_style = tab

# Docker Compose
[docker-compose*.{yaml,yml}]
indent_style = space
indent_size = 2

# Kubernetes manifests
[k8s*.{yaml,yml}]
indent_style = space
indent_size = 2

# Ansible playbooks
[*playbooks/**/*.{yaml,yml}]
indent_style = space
indent_size = 2
